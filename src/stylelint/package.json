{
  "name": "@openally/config.stylelint",
  "version": "1.0.1",
  "description": "OpenAlly Stylelint configuration for front-end with Lit.js",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test-only": "node --test ./test/**/*.test.ts",
    "test": "c8 --all --src ./src -r html npm run test-only",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAlly/configs",
    "directory": "src/stylelint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openally",
    "stylelint",
    "stylelint-config"
  ],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@stylistic/stylelint-plugin": "5.3.0",
    "postcss-lit": "1.4.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  }
}
