{
  "name": "@openally/config.stylelint",
  "version": "2.0.0",
  "description": "OpenAlly Stylelint configuration for front-end with Lit.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test-only": "node --test ./test/**/*.test.ts",
    "test": "c8 --all --src ./src -r html npm run test-only",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAlly/configs",
    "directory": "src/stylelint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openally",
    "stylelint",
    "stylelint-config"
  ],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@stylistic/stylelint-plugin": "6.0.1",
    "postcss-lit": "1.4.1",
    "stylelint-config-standard": "41.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  },
  "devDependencies": {
    "stylelint": "18.0.0"
  }
}
