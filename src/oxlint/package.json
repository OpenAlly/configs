{
  "name": "@openally/config.oxlint",
  "version": "1.0.0",
  "description": "OpenAlly Oxlint configuration for Node.js and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test-only": "node --test ./test/**/*.test.ts",
    "test": "c8 --all --src ./src -r html npm run test-only",
    "lint": "oxlint src",
    "sync": "node ./scripts/sync.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAlly/configs",
    "directory": "src/oxlint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openally",
    "oxlint",
    "oxlint-config",
    "oxc"
  ],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "oxlint": "~1.83.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.2.2",
    "@typescript-eslint/utils": "8.70.0",
    "is-core-module": "2.16.2"
  },
  "devDependencies": {
    "@types/is-core-module": "2.2.2",
    "@typescript-eslint/types": "^8.19.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002"
  }
}
